# 首次部署：cp .env.example .env，填写下方 5 项后执行 docker compose up -d。
# 生成密钥：每个密钥执行一次 openssl rand -hex 32，然后复制输出结果。
# 其余服务配置已有默认值，无需填写；请勿将 .env 提交到 Git。

# 必填：JWT 签名密钥（所有 API 实例必须保持一致）。
CSCAN_JWT_SECRET=cscan_admin_secret

# 必填：MongoDB 管理员用户名（请填写部署专用名称，例如 cscan_admin）。
CSCAN_MONGO_ROOT_USERNAME=cscan_admin

# 必填：MongoDB 管理员密码（首次创建数据卷时生效，后续修改会影响已有数据）。
CSCAN_MONGO_ROOT_PASSWORD=cscan_admin_mongodb

# 必填：Redis 访问密码（API 与 Worker 使用同一个密码）。
CSCAN_REDIS_PASSWORD=cscan_admin_redis

# 必填：Worker 注册密钥（用于 Worker 连接 API）。
CSCAN_WORKER_KEY=cscan_admin_worker
